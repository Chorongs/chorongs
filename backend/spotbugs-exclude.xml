<?xml version="1.0" encoding="UTF-8"?>
<!--
	Lombok이 만드는 List 필드 getter/setter를 SpotBugs가 "내부 목록 노출"(EI_EXPOSE_REP, EI_EXPOSE_REP2)로 잡음.
	DTO는 요청, 응답 값을 옮기는 그릇이라 목록이 노출돼도 공격 경로가 없어서, DTO 패키지에서 이 두 규칙만 끔.
	다른 패키지와 다른 규칙은 그대로 검사함. 범위를 넓히려면 dev 팀 리뷰 필수.

	Service, Controller가 생성자로 받는 Repository, Service, MemoryCache 등에 delete, put, clear처럼
	값을 바꾸는 이름의 메서드가 있으면 SpotBugs가 "밖에서 바꿀 수 있는 객체를 필드에 저장"(EI_EXPOSE_REP2)으로 잡음.
	이 객체들은 Spring이 서버 시작 때 한 번 넣어 주는 것이라 밖에서 바꿀 경로가 없어서,
	service, controller 패키지에서 EI_EXPOSE_REP2 하나만 끔 (생성자 주입은 be_common 규칙 그대로 유지). CHORONG-44
-->
<FindBugsFilter>
	<Match>
		<Package name="~chorong\..*\.dto"/>
		<Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
	</Match>
	<Match>
		<Or>
			<Package name="~chorong\..*\.service"/>
			<Package name="~chorong\..*\.controller"/>
		</Or>
		<Bug pattern="EI_EXPOSE_REP2"/>
	</Match>
</FindBugsFilter>
